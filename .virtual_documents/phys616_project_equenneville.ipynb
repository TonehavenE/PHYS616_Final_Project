force_params = ForcingParameters(
    Ω = 37.288105935600946 + 0.01, # tiny offset from a resonance
    P = (r, θ) -> 500exp(-20*r^2) # Driving the center
)

# Start the drum effectively at rest to see PURE forcing
forced_drum = generate_forced_drum((r,θ)->0.0, (r,θ)->0.0, force_params; drum_parameters=drum_parameters)


times = [0.0 0.2 0.4; 3.0 3.2 3.4; 5.0 5.2 5.4; 10.0 10.2 10.4] 
