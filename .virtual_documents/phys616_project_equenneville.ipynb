


using Plots, SpecialFunctions, Integrals, FunctionZeros





# Global parameters

# Physics
const DRUM_RADIUS = 1.0
const TENSION = 100.0
const MASS_DENSITY = 10.0
const WAVESPEED = sqrt(TENSION/MASS_DENSITY)

# Simulation 
const N_max = 5
const M_max = 5
const RESOLUTION = 100








"""
    compute_projection(m, n, f, trig_func)

Computes the coefficients for the analytic solution. 
`m` and `n` specify the mode, `f` is a function that specifies the initial condition, `trig_func` is whether this is the sin or cos mode.
Pass in the optional `velocity_mode` parameter to toggle the factor of 1/ω_mn. 
"""
function compute_projection(m::Int, n::Int, f::Function, trig_func::Function; velocity_mode::Bool=false, a::Real=DRUM_RADIUS, c::Real=WAVESPEED)
    # Physics constants
    α_mn = besselj_zero(m, n) 
    λ_mn = α_mn / a
    
    # Define the integrand closure
    function integrand(x, p)
        r, θ = x
        return f(r, θ) * besselj(m, λ_mn * r) * trig_func(m * θ) * r
    end

    # Solve Integral
    prob = IntegralProblem(integrand, ([0.0, 0.0], [a, 2π]))
    sol = solve(prob, HCubatureJL())

    # Calculate Normalization
    # Base factor matches A and B
    norm_factor = 2 / (π * a^2 * besselj(m + 1, α_mn)^2)
    
    # If this is for velocity (C or D), we must divide by omega
    if velocity_mode
        ω_mn = c * λ_mn
        norm_factor /= ω_mn
    end

    return sol.u * norm_factor
end

# Position Coefficients (cos, sin)
A(m, n, f, a=DRUM_RADIUS) = compute_projection(m, n, f, cos; velocity_mode=false, a=a)
B(m, n, f, a=DRUM_RADIUS) = compute_projection(m, n, f, sin; velocity_mode=false, a=a)

# Velocity Coefficients (cos, sin) - Set velocity_mode=true
C(m, n, f, a=DRUM_RADIUS, c=WAVESPEED) = compute_projection(m, n, f, cos; velocity_mode=true, a=a, c=c)
D(m, n, f, a=DRUM_RADIUS, c=WAVESPEED) = compute_projection(m, n, f, sin; velocity_mode=true, a=a, c=c)


"""
    DrumParameters

Stores all of the parameters for a full drum simulation.
"""
Base.@kwdef struct DrumParameters
    radius::Real = DRUM_RADIUS
    wavespeed::Real = WAVESPEED
    N_max::Int = N_max # number of N modes
    M_max::Int = M_max # number of M modes
    spatial_points::Int = RESOLUTION # number of spatial points for a simulation
end


"""
    populate_coefficients(f, g; drum_parameters)

Computes upfront the matrix of coefficients A, B, C, D, Λ, and Ω for the analytic solution.
This puts all of the costly integrals in one step.
"""
function populate_coefficients(f::Function, g::Function; drum_parameters::DrumParameters = DrumParameters())
    a = drum_parameters.radius
    c = drum_parameters.wavespeed
    N_max = drum_parameters.N_max
    M_max = drum_parameters.M_max
    
    # We use m+1 because Julia arrays are 1-indexed, but m starts at 0
    CoeffsA = zeros(Float64, M_max + 1, N_max)
    CoeffsB = zeros(Float64, M_max + 1, N_max)
    CoeffsC = zeros(Float64, M_max + 1, N_max)
    CoeffsD = zeros(Float64, M_max + 1, N_max)
    Lambdas = zeros(Float64, M_max + 1, N_max)
    Omegas  = zeros(Float64, M_max + 1, N_max)

    # Fill the matrices
    for m in 0:M_max
        for n in 1:N_max
            # Physics Constants
            α_mn = besselj_zero(m, n)
            λ_mn = α_mn / a
            ω_mn = c * λ_mn
            
            # Store constants
            Lambdas[m+1, n] = λ_mn
            Omegas[m+1, n]  = ω_mn
            
            # Calculate and store Integration Coefficients
            CoeffsA[m+1, n] = A(m, n, f, a)
            CoeffsB[m+1, n] = B(m, n, f, a)
            CoeffsC[m+1, n] = C(m, n, g, a, c)
            CoeffsD[m+1, n] = D(m, n, g, a, c)
        end
    end

    return CoeffsA, CoeffsB, CoeffsC, CoeffsD, Lambdas, Omegas
end

"""
    generate_drum_function(f, g, drum_parameters)

Given the initial condition functions `f` and `g`, returns a function u(r, θ, t)
that represents the height of the drum at radius `r`, angle `θ`, and time `t`.
`f` is the initial position of the drum, and `g` is the initial velocity.
"""
function generate_drum_function(f::Function, g::Function; drum_parameters::DrumParameters = DrumParameters())::Function
    CoeffsA, CoeffsB, CoeffsC, CoeffsD, Lambdas, Omegas = populate_coefficients(f, g; drum_parameters=drum_parameters)
    function u(r, θ, t)
        val = 0.0
        for m in 0:drum_parameters.M_max
            for n in 1:drum_parameters.N_max
                # Retrieve pre-calculated values
                λ = Lambdas[m+1, n]
                ω = Omegas[m+1, n]
                Am = CoeffsA[m+1, n]
                Bm = CoeffsB[m+1, n]
                Cm = CoeffsC[m+1, n]
                Dm = CoeffsD[m+1, n]
                
                # Compute spatial and temporal components
                # J_m(λr)
                radial = besselj(m, λ * r)
                
                # (A cos mθ + B sin mθ) cos(ωt)
                temporal_pos = (Am * cos(m * θ) + Bm * sin(m * θ)) * cos(ω * t)
                
                # (C cos mθ + D sin mθ) sin(ωt)
                temporal_vel = (Cm * cos(m * θ) + Dm * sin(m * θ)) * sin(ω * t)
                
                val += radial * (temporal_pos + temporal_vel)
            end
        end
        return val
    end
    return u
end





"""
    mode_z_map(m, n, x, y; drum_parameters)

Computes the height map for the drum mode `m` and `n` at the points `x` and `y`.
"""
function mode_z_map(m::Int, n::Int, x, y; drum_parameters::DrumParameters = DrumParameters())
    drum_radius = drum_parameters.radius
    spatial_points = drum_parameters.spatial_points
    
    α_mn = besselj_zero(m, n)
    λ = α_mn / drum_radius

    # \psi_{m,n}(r, θ) = J_m(λr) * cos(mθ)
    z = [
        begin
            r = sqrt(xi^2 + yi^2)
            if r > DRUM_RADIUS
                NaN # Mask corners
            else
                θ = atan(yi, xi)
                besselj(m, λ * r) * cos(m * θ)
            end
        end
        for yi in y, xi in x # Note: y is rows, x is cols
    ]
    return z
end


"""
    plot_mode(m, n; drum_parameters)

Plots the height map of the drum mode `m`, `n`. 
"""
function plot_mode(m::Int, n::Int; drum_parameters::DrumParameters = DrumParameters())
    drum_radius = drum_parameters.radius
    spatial_points = drum_parameters.spatial_points
    x = range(-drum_radius, drum_radius, length=spatial_points)
    y = range(-drum_radius, drum_radius, length=spatial_points)
    z = mode_z_map(m, n, x, y; drum_parameters=drum_parameters)
    
    heatmap(x, y, z,
        c = :balance,
        clims = (-1, 1),
        aspect_ratio = :equal,
        axis = nothing,
        border = :none,
        title = "m=$m, n=$n",
        titlefontsize = 10,
        colorbar = false,
        margin = 1Plots.mm
    )
end


"""
    mode_grid(m_range, n_range; drum_parameters, filepath)

Plots a grid of normal modes.
"""
function mode_grid(m_range = 0:2, n_range = 1:3; drum_parameters::DrumParameters = DrumParameters(), filepath = "normal_modes.png")
    
    # Generate the grid of drum modes
    plots_list = []
    for m in m_range
        for n in n_range
            p = plot_mode(m, n; drum_parameters=drum_parameters)
            push!(plots_list, p)
        end
    end

    # Create a big color bar
    bar = scatter([0], [0], 
        zcolor=[0], 
        clims=(-1, 1), 
        xlims=(1,1.1), 
        label="", 
        c=:balance, 
        grid=false, 
        axis=nothing,
        colorbar_title="Displacement",
        framestyle=:none,
        left_margin = 5Plots.mm,
        right_margin = 5Plots.mm
    )

    # Define a layout to group everything
    rows = length(m_range)
    cols = length(n_range)
    l = @layout [grid(rows, cols) a{0.1w}] 

    # Combine all the modes and the bar into one big plot
    plt = plot(plots_list..., bar, 
        layout = l, 
        size = (1600, 1600), 
        plot_title = "Normal Modes of a Drum",
        margin = 5Plots.mm 
    )
    
    savefig(plt, filepath)
    return plt
end


"""
    animate_modes(m_range, n_range; drum_parameters, frames)

Creates an animation of the drum modes.
"""
function animate_modes(m_range = 0:2, n_range = 1:3; drum_parameters::DrumParameters = DrumParameters(spatial_points = 40), frames::Int = 60)
    R = drum_parameters.radius
    resolution = drum_parameters.spatial_points
    println("Pre-computing shapes...")
    x = range(-R, R, length=resolution)
    y = range(-R, R, length=resolution)

    # Store the modes in a grid
    base_shapes = Matrix{Matrix{Float64}}(undef, length(m_range), length(n_range))
    # Define the grid
    x = range(-R, R, length=resolution)
    y = range(-R, R, length=resolution)
    
    for m in m_range
        for n in n_range
            base_shapes[m+1, n] = mode_z_map(m, n, x, y; drum_parameters = drum_parameters)
        end
    end
    
    # Animation time
    println("Rendering frames...")
    
    anim = @animate for t_idx in 0:(frames-1)
        # We use a normalized time so all modes complete ~1-2 cycles
        # This is "Visual Time", not strict "Physics Time" (which would be chaotic)
        t = 2π * t_idx / frames
        
        plots_list = []
        
        for m in m_range
            for n in n_range
                # We multiply the static base shape by cos(t)
                # This makes it vibrate up and down
                current_z = base_shapes[m+1, n] .* cos(t)
                
                # Create sub-plot
                p = surface(x, y, current_z,
                    zlims=(-1, 1),
                    clims=(-1, 1),
                    c=:viridis,
                    camera=(30, 40), # Standard isometric view
                    axis=nothing,    # Hide axes for cleaner look
                    border=:none,
                    colorbar=false,
                    title="m=$m, n=$n",
                    titlefontsize=10
                )
                push!(plots_list, p)
            end
        end

        # Combine all plots
        plot(plots_list..., layout=(length(m_range), length(n_range)), size=(1600, 1600), margin=0Plots.mm)
        
        # Progress bar for sanity
        if t_idx % 10 == 0
            print(".")
        end
    end
    return anim
end


"""
    plot_filmstrip(drum_func, times::AbstractArray; drum_parameters)

Plots a series of snapshots. 
If `times` is a Matrix, the output grid will match the matrix shape.
"""
function plot_filmstrip(drum_func, times::AbstractArray; drum_parameters::DrumParameters = DrumParameters(), title="drum_filmstrip.pdf")
    drum_radius = drum_parameters.radius
    resolution = drum_parameters.spatial_points
    x_range = range(-drum_radius, drum_radius, length=resolution)
    y_range = range(-drum_radius, drum_radius, length=resolution)    
    
    # Handle Layout Logic
    if times isa AbstractMatrix
        # If it's a matrix, we want the plot grid to match the matrix shape.
        # Plots.jl fills row-by-row, but Julia iterates matrices column-by-column.
        # We transpose (permutedims) and flatten to get the correct row-major order.
        layout_dims = size(times)
        times_ordered = vec(permutedims(times))
        
        # Calculate a nice image size based on the grid dimensions
        # e.g., 300px per column, 300px per row
        rows, cols = size(times)
        img_size = (300 * cols, 300 * rows)
    else
        # If it's just a Vector, let Plots.jl decide the best grid
        layout_dims = length(times)
        times_ordered = times
        img_size = (900, 600) # Default size
    end

    plot_list = []
    
    for t in times_ordered
        p = surface(x_range, y_range, (x, y) -> begin
                r = sqrt(x^2 + y^2)
                θ = atan(y, x)
                r > drum_radius ? NaN : drum_func(r, θ, t)
            end,
            zlims=(-1.0, 1.0),
            clims=(-1.0, 1.0),
            c=:viridis,
            camera=(30, 50),    
            title="t = $(round(t, digits=2))",
            titlefontsize=10,
            xlabel="", ylabel="",
            colorbar=false,
            axis=nothing,      
            border=:none
        )
        push!(plot_list, p)
    end

    # Combine using the dynamic layout and size
    final_plot = plot(plot_list..., 
        layout=layout_dims, 
        size=img_size, 
        margin=2Plots.mm
    )
    
    savefig(final_plot, title)
    return final_plot
end


"""
    plot_trace(drum_func, r_probe, θ_probe, t_max)

Plots a trace of how a single point at (r_probe, θ_probe) evolves through time according to `drum_func` from 0 to `t_max`.
"""
function plot_trace(drum_func, r_probe, θ_probe, t_max; title = "drum_trace.pdf")
    # High resolution time array
    t_vals = 0:0.01:t_max
    
    # Calculate displacement at the specific probe point
    u_vals = [drum_func(r_probe, θ_probe, t) for t in t_vals]
    
    p = plot(t_vals, u_vals,
        xlabel="Time (t)",
        ylabel="Displacement u(t)",
        title="Displacement at r=$r_probe, θ=$(round(θ_probe, digits=2))",
        lw=2,
        legend=false,
        grid=true,
        size=(800, 300) # wide, short aspect ratio seems fine
    )
    
    savefig(p, title)
    return p
end


function plot_surface_frame(drum, x, y; t = 0, drum_parameters = DrumParameters(), title = "Initial Condition (t = 0)")
    drum_radius = drum_parameters.radius
    resolution = drum_parameters.spatial_points
    
    surface(x, y, (x, y) -> begin
            r = sqrt(x^2 + y^2)
            θ = atan(y, x)
            # Mask the corners to make it a circle
            if r > DRUM_RADIUS
                return NaN
            end
            return drum(r, θ, t)
        end,
        camera = (30, 30), # Angle: (Azimuth, Elevation)
        c = :viridis,
        clims=(-1, 1), 
        zlims = (-1.3, 1.3), # Fix vertical height for consistency across frames
        title = title,
        size = (800, 800),
        xlabel = "x", ylabel = "y"
    )
end


function animate_surface(drum, x, y, t_range = 0:0.01:2.0; drum_parameters = DrumParameters())
    # Create an animation object
    anim = @animate for t in t_range
        plot_surface_frame(drum, x, y; t = t, drum_parameters = drum_parameters, title = "Drum Head at t=$(round(t, digits=2))")
    end
    return anim
end








