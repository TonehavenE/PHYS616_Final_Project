Base.@kwdef struct ForcingParameters
    active::Bool = true
    Ω::Float64 = 15.0       # Driving Frequency
    P::Function = (r, θ) -> exp(-10*r^2) # Shape of the force (e.g., speaker in center)
end


function populate_forcing_coefficients(force_params::ForcingParameters; drum_parameters::DrumParameters)
    M_max = drum_parameters.M_max
    N_max = drum_parameters.N_max
    
    # Store force coefficients
    CoeffsF = zeros(Float64, M_max + 1, N_max)

    # We assume the force is symmetric (cosine) for simplicity, 
    # but you could add a Sine component if the speaker is off-axis
    for m in 0:M_max
        for n in 1:N_max
            # This projects the shape P(r, θ) onto the Bessel mode
            # Note: We divide by Tension (T) as per the wave equation derivation
            projection = compute_projection(m, n, force_params.P, cos; a=drum_parameters.radius)
            
            # We scale by wavespeed^2/Tension to match the units of the ODE
            CoeffsF[m+1, n] = projection * (drum_parameters.wavespeed^2 / TENSION)
        end
    end
    return CoeffsF
end


function generate_forced_drum(f, g, force_params::ForcingParameters; drum_parameters::DrumParameters)
    # Get standard free vibration coefficients 
    CoeffsA, CoeffsB, CoeffsC, CoeffsD, Lambdas, Omegas = populate_coefficients(f, g; drum_parameters=drum_parameters)

    println(Omegas)
    
    # Get forcing coefficients
    CoeffsF = populate_forcing_coefficients(force_params; drum_parameters=drum_parameters)

    println(CoeffsF)
    
    Ω = force_params.Ω # Driving frequency

    function u(r, θ, t)
        val = 0.0
        for m in 0:drum_parameters.M_max
            for n in 1:drum_parameters.N_max
                λ = Lambdas[m+1, n]
                ω = Omegas[m+1, n] # Natural frequency of this mode
                
                # Standard Free Vibration Terms
                term_free = (CoeffsA[m+1, n] * cos(m*θ) + CoeffsB[m+1, n] * sin(m*θ)) * cos(ω*t) +
                            (CoeffsC[m+1, n] * cos(m*θ) + CoeffsD[m+1, n] * sin(m*θ)) * sin(ω*t)

                # Forced Vibration Term
                # T_forced = F_mn / (ω² - Ω²) * (cos(Ωt) - cos(ωt))
                # We add a tiny epsilon to avoid division by zero if Ω exactly matches ω
                F_mn = CoeffsF[m+1, n]
                denominator = (ω^2 - Ω^2)
                if abs(denominator) < 1e-9; denominator = 1e-9; end # Avoid singularity
                
                # We apply the force mostly to the cosine angular modes
                # println("cos(Ωt) = $(cos(Ω * t))")
                # println("cos(ωt) = $(cos(ω * t))")
                # println("cos(mθ) = $(cos(m * θ))")
                # println("so the total is $( (cos(Ω * t) - cos(ω * t)) * cos(m * θ) )")
                term_forced = (F_mn / denominator) * (cos(Ω * t) - cos(ω * t)) * cos(m * θ)
                val += besselj(m, λ * r) * (term_free + term_forced)
            end
        end
        # println("val is $(val)")
        return val
    end
    return u
end





"""
    plot_resonance_curve(m, n; drum_parameters, max_omega)

Plots the theoretical amplitude response of mode (m,n).
"""
function plot_resonance_curve(m::Int, n::Int; drum_parameters::DrumParameters = DrumParameters(), max_omega=50.0)
    c = drum_parameters.wavespeed
    a = drum_parameters.radius
    
    # Calculate Natural Frequency
    α_mn = besselj_zero(m, n)
    ω_natural = c * (α_mn / a)
    
    # Frequency Range
    Ω_range = range(0, max_omega, length=1000)
    
    # Amplitude Response (avoiding exact singularity)
    # We add a small damping factor or floor to keep the log-plot sane
    amplitude(Ω) = 1.0 / sqrt((ω_natural^2 - Ω^2)^2 + 0.01) 
    
    response = amplitude.(Ω_range)

    # Plot
    plot(Ω_range, response,
        title = "m=$m, n=$n",
        titlefontsize = 10,
        yscale = :log10,
        ylims = (1e-4, 1e2), # Fixed Y-limits are crucial for "Shared Axes" feel
        xlims = (0, max_omega),
        label = nothing,
        color = :blue,
        lw = 1.5,
        grid = true
    )
    
    # Mark the natural frequency
    vline!([ω_natural], linestyle=:dash, color=:red, label=nothing)
end


"""
    resonance_grid(m_range, n_range; drum_parameters, max_omega, filepath)

Generates a grid of resonance curves with shared axes.
"""
function resonance_grid(m_range = 0:2, n_range = 1:3; 
                        drum_parameters::DrumParameters = DrumParameters(), 
                        max_omega=50.0, 
                        filepath = "src/resonance_grid.pdf")
    
    plots_list = []
    
    for m in m_range
        for n in n_range
            p = plot_resonance_curve(m, n; drum_parameters=drum_parameters, max_omega=max_omega)
            push!(plots_list, p)
        end
    end
    
    # Combine with shared axes (link = :all)
    # We remove inner tick labels to make it look like one cohesive chart
    plt = plot(plots_list..., 
        layout = (length(m_range), length(n_range)), 
        size = (1200, 1000), 
        link = :all,             # <--- This forces shared axes
        plot_title = "Resonance Response by Mode",
        left_margin = 2Plots.mm,
        bottom_margin = 2Plots.mm
    )
    
    savefig(plt, filepath)
    return plt
end





